{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "synthetic",
    "question",
    "control_refs",
    "evidence_to_collect",
    "assessment_status",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "const": true
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "control_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_to_collect": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assessment_status": {
      "const": "not-assessed"
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
