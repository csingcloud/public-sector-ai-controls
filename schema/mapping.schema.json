{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mappings"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "target",
          "relationship",
          "review_status",
          "rationale",
          "limitation",
          "source_locator"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "relationship": {
            "const": "related"
          },
          "review_status": {
            "const": "candidate"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "limitation": {
            "type": "string",
            "minLength": 1
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
