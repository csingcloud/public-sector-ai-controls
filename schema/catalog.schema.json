{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "framework",
    "version",
    "source_url",
    "checked_on",
    "coverage",
    "controls"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "framework": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "checked_on": {
      "type": "string",
      "format": "date"
    },
    "coverage": {
      "const": "selected-references"
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_locator",
          "label",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
